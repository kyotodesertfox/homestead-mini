---
import '../styles/global.css';
import tasksData from '../data/tasks.json';
import procurementData from '../data/procurement.json';

const gardenTasks = tasksData.filter(t => t.category === 'garden');
const gardenInProgress = gardenTasks.filter(t => t.status === 'pending' || t.status === 'claimed');
const gardenHasOpen = gardenTasks.some(t => t.status === 'open');

const procurementTasks = procurementData;
const procurementInProgress = procurementTasks.filter(t => t.status === 'pending' || t.status === 'claimed');
const procurementHasOpen = procurementTasks.some(t => t.status === 'open');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2316a34a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="A local exchange where neighbors trade goods and labor without cash." />
    <title>Homestead - Local Exchange</title>
    <meta property="og:title" content="Homestead - Local Exchange" />
    <meta property="og:description" content="A local exchange where neighbors trade goods and labor without cash." />
    <meta property="og:image" content="https://homestead-mini.netlify.app/og.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://homestead-mini.netlify.app/og.png" />
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-80DTD35CDL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-80DTD35CDL');
    </script>
  </head>
  <body class="bg-[#FAF7F2] text-[#2C2C2C] font-sans">

    <!-- Header -->
    <header class="px-6 pt-6 pb-2 max-w-3xl mx-auto">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-[#3B5E3A]">Homestead</h1>
          <p class="text-[#7A6652] mt-1 text-sm">A local exchange for neighbors</p>
        </div>

        <div class="hidden sm:flex flex-col items-end gap-1.5">
          <!-- Desktop nav pill -->
          <nav class="flex items-center gap-1 bg-white border border-[#E8DDD0] rounded-full px-3 py-2 shadow-sm text-sm">
            <a href="#how-it-works" class="px-3 py-1 rounded-full text-[#7A6652] hover:bg-[#3B5E3A] hover:text-white transition font-medium">How it works</a>
            <a href="#what-we-have" class="px-3 py-1 rounded-full text-[#7A6652] hover:bg-[#3B5E3A] hover:text-white transition font-medium">What we have</a>
            <a href="#work-available" class="px-3 py-1 rounded-full text-[#7A6652] hover:bg-[#3B5E3A] hover:text-white transition font-medium">Work available</a>
          </nav>

          <!-- Nudge toward the main Exchange app - flag/pennant shape, not another pill -->
          <a href="https://homesteaders.netlify.app" target="_blank" rel="noopener" class="text-[11px] font-semibold tracking-wide text-white bg-[#16a34a] pl-3 pr-6 py-1.5 hover:bg-[#3B5E3A] transition [clip-path:polygon(0%_0%,88%_0%,100%_50%,88%_100%,0%_100%)] [filter:drop-shadow(0_1px_2px_rgba(0,0,0,0.15))]">
            Looking for Homestead Exchange?
          </a>
        </div>

        <!-- Hamburger (mobile only) -->
        <button
          id="menu-toggle"
          class="sm:hidden flex flex-col justify-center items-center w-10 h-10 rounded-full bg-white border border-[#E8DDD0] shadow-sm gap-1.5"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span id="bar1" class="block w-5 h-0.5 bg-[#3B5E3A] transition-all duration-200 origin-center"></span>
          <span id="bar2" class="block w-5 h-0.5 bg-[#3B5E3A] transition-all duration-200"></span>
          <span id="bar3" class="block w-5 h-0.5 bg-[#3B5E3A] transition-all duration-200 origin-center"></span>
        </button>
      </div>

      <!-- Mobile menu drawer -->
      <nav
        id="mobile-menu"
        class="sm:hidden hidden mt-4 bg-white border border-[#E8DDD0] rounded-2xl shadow-md overflow-hidden"
        aria-label="Mobile navigation"
      >
        <a href="#how-it-works" class="mobile-nav-link flex items-center gap-3 px-5 py-4 border-b border-[#F0E8DF] text-[#2C2C2C] font-medium hover:bg-[#FAF7F2] transition">
          <span class="text-lg">🔧</span> How it works
        </a>
        <a href="#what-we-have" class="mobile-nav-link flex items-center gap-3 px-5 py-4 border-b border-[#F0E8DF] text-[#2C2C2C] font-medium hover:bg-[#FAF7F2] transition">
          <span class="text-lg">🥚</span> What we have
        </a>
        <a href="#work-available" class="mobile-nav-link flex items-center gap-3 px-5 py-4 text-[#2C2C2C] font-medium hover:bg-[#FAF7F2] transition">
          <span class="text-lg">🌿</span> Work available
        </a>
      </nav>
    </header>

    <main class="px-6 pt-8 max-w-3xl mx-auto space-y-16 pb-16">

      <!-- Hero + How it works -->
      <section id="how-it-works" class="space-y-6">
        <h2 class="text-2xl font-semibold text-[#2C2C2C] leading-snug">
          Trade what you have.<br />Get what you need.
        </h2>

        <p class="text-[#7A6652] text-lg leading-relaxed">
          Bartering is older than money. Neighbors traded what they had for what they needed - labor for food, skills for goods, time for something real - with no intermediary in the middle and no account required. Money solved a "problem of wants" but added a dependency: the bank decides who gets to participate.
        </p>

        <p class="text-[#7A6652] leading-relaxed">
          When that access is difficult, barter fills the gap. Two people with something the other needs can make a deal without anyone's permission. We allow everyone to participate and conduct honest commerce.
        </p>

        <div class="bg-[#D4A017]/10 border-l-4 border-[#D4A017] rounded-r-xl px-5 py-4 space-y-1.5">
          <p class="text-[#2C2C2C] font-medium">In a cash deal, one party always loses.</p>
          <p class="text-[#2C2C2C] font-semibold text-lg">We prefer both parties win.</p>
          <p class="text-sm text-[#7A6652] pt-1">Barter first. Crypto gladly. Cash accepted - but never preferred.</p>
        </div>

        <h3 class="text-xs font-semibold uppercase tracking-widest text-[#D4A017] pt-2">How it works</h3>
        <ol class="space-y-5 list-none">
          <li class="flex items-start gap-3">
            <span class="text-[#3B5E3A] font-bold text-lg">1.</span>
            <div>
              <p class="font-semibold">See what's available</p>
              <p class="text-sm text-[#7A6652] mt-1">Browse what's on offer - eggs, honey, beer, labor, skills. You can see exactly what this homestead has and what it needs.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#3B5E3A] font-bold text-lg">2.</span>
            <div>
              <p class="font-semibold">Reach out with what you have</p>
              <p class="text-sm text-[#7A6652] mt-1">Send a message describing what you can offer. It can be labor, a skill, something you grew, something you made - anything with real value to someone else.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#3B5E3A] font-bold text-lg">3.</span>
            <div>
              <p class="font-semibold">Agree on a trade</p>
              <p class="text-sm text-[#7A6652] mt-1">We figure out what's fair between us. Two hours of yard work for a dozen eggs. A jar of your jam for a jar of our honey. Whatever makes sense to both sides.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#3B5E3A] font-bold text-lg">4.</span>
            <div>
              <p class="font-semibold">Exchange in person</p>
              <p class="text-sm text-[#7A6652] mt-1">Meet up, do the work, hand over the goods. No payment processor. No bank account. Cash is welcome too - but never required.</p>
            </div>
          </li>
        </ol>
      </section>

      <!-- What we have -->
      <section id="what-we-have">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-[#D4A017] mb-6">What we have</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-4 bg-white rounded-xl px-5 py-4 shadow-sm">
            <span class="text-2xl">🥚</span>
            <div>
              <p class="font-semibold">Eggs</p>
              <p class="text-sm text-[#7A6652]">Fresh from the yard. Available weekly.</p>
            </div>
          </li>
          <li class="flex items-start gap-4 bg-white rounded-xl px-5 py-4 shadow-sm">
            <span class="text-2xl">🍯</span>
            <div>
              <p class="font-semibold">Honey</p>
              <p class="text-sm text-[#7A6652]">Raw, local, seasonal.</p>
            </div>
          </li>
          <li class="bg-white rounded-xl shadow-sm">
            <button class="have-toggle w-full flex items-center gap-4 px-5 py-4 text-left">
              <span class="text-2xl">🍺</span>
              <div class="flex-1">
                <p class="font-semibold">Beer</p>
                <p class="text-sm text-[#7A6652]">Small batch, home brewed.</p>
              </div>
              <svg class="have-chevron w-4 h-4 text-[#7A6652] transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="have-body border-t border-[#F0E8DF] px-5 py-5">
              <div class="bg-[#D4A017]/10 border border-[#D4A017]/30 rounded-xl px-5 py-5 text-center mx-auto max-w-xs">
                <p class="text-[10px] font-semibold uppercase tracking-widest text-[#D4A017] mb-1">Currently on tap</p>
                <p class="text-[#7A6652] text-[11px] mb-4">Available in Bottles / Draft</p>
                <p class="text-[#2C2C2C] font-bold text-lg leading-snug mb-1">Caribou Slobber</p>
                <p class="text-[#7A6652] text-xs mb-4">Recipe by Northern Brewers</p>
                <a href="https://cdn.shopify.com/s/files/1/2785/6868/t/3/assets/CaribouSlobber-1526673747421.pdf?528002487593717657" target="_blank" rel="noopener" class="inline-block text-xs font-semibold text-[#D4A017] border border-[#D4A017]/40 rounded-full px-4 py-1.5 hover:bg-[#D4A017]/20 transition">View recipe</a>
              </div>
            </div>
          </li>
        </ul>
      </section>

      <!-- What we need -->
      <section>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-[#D4A017] mb-6">What we need</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-4">
            <span class="text-2xl">🌿</span>
            <div>
              <p class="font-semibold">Garden and yard labor</p>
              <p class="text-sm text-[#7A6652]">Clearing, planting, maintaining.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-2xl">🔧</span>
            <div>
              <p class="font-semibold">Skills and repairs</p>
              <p class="text-sm text-[#7A6652]">Carpentry, mechanical, general handy work.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-2xl">🧺</span>
            <div>
              <p class="font-semibold">Goods and produce</p>
              <p class="text-sm text-[#7A6652]">Have something worth trading? Bring it.</p>
            </div>
          </li>
        </ul>
      </section>

      <!-- Work available -->
      <section id="work-available">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-[#D4A017] mb-2">Work available</h3>
        <p class="text-sm text-[#7A6652] mb-6">These are tasks that need doing. Payment is in eggs, honey, or beer - no cash required. Claim one below and I will be in touch.</p>
        <ul class="space-y-4">

          <!-- Garden clearing - accordion -->
          <li class="bg-white rounded-xl shadow-sm border-l-4 border-[#3B5E3A]">
            <button class="task-toggle w-full px-5 py-4 flex items-center justify-between gap-4 text-left">
              <div>
                <p class="font-semibold">Homestead Tasks</p>
                <p class="text-sm text-[#3B5E3A]/70 mt-1">Individual tasks - click to see what is open.</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs font-semibold text-[#3B5E3A] bg-[#3B5E3A]/10 px-3 py-1 rounded-full">Pays in eggs</span>
                <svg class="task-chevron w-4 h-4 text-[#3B5E3A] transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </button>

            <div class="task-list">
              {gardenTasks.length > 0 && (
                <div class="flex flex-col gap-2 px-5 py-4 border-t border-[#F0E8DF]">
                  {gardenTasks.map(t => (
                    <button
                      class={`task-pill w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl transition text-left ${t.status === 'open' ? 'group bg-[#f4f8f4] border-2 border-[#3B5E3A]/30 hover:border-[#3B5E3A]/60 hover:bg-[#eaf2ea] active:bg-[#dceadc]' : 'bg-[#f5f5f5] border-2 border-[#E8DDD0] opacity-50 cursor-default'}`}
                      data-task={t.task}
                      data-eggs={String(t.eggs)}
                      data-status={t.status}
                      data-image={t.image || ''}
                      data-url=""
                      data-formname="job-claim"
                    >
                      <span class="text-sm text-[#2C2C2C] font-medium leading-snug">{t.task}</span>
                      <span class={`text-[10px] font-semibold px-2.5 py-1 rounded-full shrink-0 transition ${t.status === 'open' ? 'text-[#3B5E3A] bg-[#3B5E3A]/12 group-active:bg-[#3B5E3A] group-active:text-white' : 'text-[#7A6652] bg-[#7A6652]/10'}`}>{t.eggs} eggs</span>
                    </button>
                  ))}
                </div>
              )}

              {gardenInProgress.length > 0 && (
                <div class="border-t border-[#F0E8DF] bg-[#FAF7F2] px-5 py-3 space-y-1">
                  <p class="text-xs font-semibold uppercase tracking-widest text-[#D4A017] mb-2">In progress</p>
                  {gardenInProgress.map(t => (
                    <p class="text-sm text-[#2C2C2C]">
                      <span class="font-medium">{t.anonymous ? 'Anonymous' : t.claimedBy}</span>
                      <span class="text-[#7A6652]"> - {t.task}</span>
                    </p>
                  ))}
                </div>
              )}

              {gardenHasOpen && (
                <div class="task-claim-panel border-t border-[#F0E8DF] bg-[#FAF7F2] px-5 py-4">
                  <p class="task-claim-label text-sm font-semibold text-[#2C2C2C] mb-3"></p>
                  <form name="job-claim" netlify netlify-honeypot="bot-field" method="POST">
                    <input type="hidden" name="form-name" value="job-claim" />
                    <input type="hidden" name="job" class="task-name-field" value="" />
                    <p class="hidden"><input name="bot-field" /></p>
                    <div class="space-y-3">
                      <input name="name" required placeholder="Your name" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#3B5E3A]" />
                      <input name="contact" required placeholder="Phone or email" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#3B5E3A]" />
                      <textarea name="message" rows="2" placeholder="Anything to add? (optional)" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#3B5E3A] resize-none"></textarea>
                      <label class="flex items-center gap-2 text-sm text-[#7A6652] cursor-pointer">
                        <input type="checkbox" name="anonymous" value="yes" class="rounded border-[#E8DDD0]" />
                        Keep my name private
                        <span class="relative inline-flex items-center ml-1">
                          <span class="anon-info-btn w-4 h-4 rounded-full bg-[#E8DDD0] text-[#7A6652] text-[9px] font-bold flex items-center justify-center leading-none cursor-pointer select-none">?</span>
                          <span class="anon-tooltip hidden absolute left-0 bottom-6 z-50 w-56 bg-[#2C2C2C] text-white rounded-xl px-3 py-2.5 shadow-xl text-left">
                            <p class="text-[11px] text-[#ccc] leading-relaxed">We like to barter with our neighbors - displaying your name lets others know who is helping in the community. We respect your privacy if you prefer not to.</p>
                          </span>
                        </span>
                      </label>
                      <div class="flex gap-3">
                        <button type="submit" class="submit-btn text-sm font-semibold bg-[#3B5E3A] text-white rounded-full px-5 py-2 hover:opacity-90 transition">Send</button>
                        <button type="button" class="task-cancel-btn text-sm text-[#7A6652] px-3 py-2 hover:text-[#2C2C2C] transition">Cancel</button>
                      </div>
                    </div>
                  </form>
                  <p class="success-msg hidden text-sm text-[#3B5E3A] font-medium py-2">Got it - I will reach out soon.</p>
                </div>
              )}
            </div>
          </li>

          <!-- Procurement accordion -->
          <li class="bg-white rounded-xl shadow-sm border-l-4 border-[#D4A017]">
            <button class="task-toggle w-full px-5 py-4 flex items-center justify-between gap-4 text-left">
              <div>
                <p class="font-semibold">Procurement</p>
                <p class="text-sm text-[#7A6652] mt-1">Items or materials we are looking to source. Click to see what is needed.</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs font-semibold text-[#D4A017] bg-[#D4A017]/10 px-3 py-1 rounded-full">Pays in eggs</span>
                <svg class="task-chevron w-4 h-4 text-[#7A6652] transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </button>

            <div class="task-list">
              {procurementTasks.length === 0 && (
                <div class="px-5 py-4 border-t border-[#F0E8DF]">
                  <p class="text-sm text-[#7A6652]">Nothing listed yet - check back soon.</p>
                </div>
              )}
              {procurementTasks.length > 0 && (
                <div class="flex flex-col gap-2 px-5 py-4 border-t border-[#F0E8DF]">
                  {procurementTasks.map(t => (
                    <button
                      class={`task-pill w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl transition text-left ${t.status === 'open' ? 'group bg-[#FFFBF2] border-2 border-[#D4A017]/40 hover:border-[#D4A017]/70 hover:bg-[#FFF3D6] active:bg-[#FFE9A0]' : 'bg-[#f5f5f5] border-2 border-[#E8DDD0] opacity-50 cursor-default'}`}
                      data-task={t.task}
                      data-eggs={String(t.eggs)}
                      data-status={t.status}
                      data-image=""
                      data-url={t.url || ''}
                      data-formname="procurement"
                    >
                      <span class="text-sm text-[#2C2C2C] font-medium leading-snug">{t.task}</span>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <span class={`text-[10px] font-semibold px-2.5 py-1 rounded-full transition ${t.status === 'open' ? 'text-[#D4A017] bg-[#D4A017]/15 group-active:bg-[#D4A017] group-active:text-[#1a1a1a]' : 'text-[#7A6652] bg-[#7A6652]/10'}`}>{t.eggs} eggs</span>
                        {t.eggs > 24 && (
                          <span class="relative shrink-0">
                            <span class="egg-warn-trigger w-4 h-4 rounded-full bg-[#D4A017] text-[#1a1a1a] text-[9px] font-bold flex items-center justify-center leading-none cursor-pointer">!</span>
                            <span class="egg-warn-tooltip hidden absolute right-0 bottom-6 z-50 w-72 bg-[#2C2C2C] text-white rounded-xl px-3.5 py-3 shadow-xl text-left">
                              <p class="text-xs font-semibold text-[#D4A017] mb-1.5">That's a lot of eggs.</p>
                              <p class="text-xs text-[#ccc] leading-relaxed mb-2">We don't always have them all on hand - so we'll send you <span class="text-white font-medium">$EGG</span> <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:-1px;margin:0 1px"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg> tokens instead. Each one is a neighbor's promise - redeemable for a real egg, or tradeable for something else entirely.</p>
                              <p class="text-xs text-[#ccc] leading-relaxed mb-2">Gift it, trade it for a favor, bring it to the market. Whoever holds one can always redeem it - the promise doesn't expire.</p>
                              <p class="text-[10px] text-[#888] leading-relaxed">New to wallets? It takes 2 minutes - <a href="https://metamask.io" target="_blank" rel="noopener" class="text-[#D4A017] underline hover:text-white transition">get one free here.</a></p>
                            </span>
                          </span>
                        )}
                      </div>
                    </button>
                  ))}
                </div>
              )}

              {procurementInProgress.length > 0 && (
                <div class="border-t border-[#F0E8DF] bg-[#FAF7F2] px-5 py-3 space-y-1">
                  <p class="text-xs font-semibold uppercase tracking-widest text-[#D4A017] mb-2">In progress</p>
                  {procurementInProgress.map(t => (
                    <p class="text-sm text-[#2C2C2C]">
                      <span class="font-medium">{t.anonymous ? 'Anonymous' : t.claimedBy}</span>
                      <span class="text-[#7A6652]"> - {t.task}</span>
                    </p>
                  ))}
                </div>
              )}

              {procurementHasOpen && (
                <div class="task-claim-panel border-t border-[#F0E8DF] bg-[#FAF7F2] px-5 py-4">
                  <p class="task-claim-label text-sm font-semibold text-[#2C2C2C] mb-3"></p>
                  <form name="procurement" netlify netlify-honeypot="bot-field" method="POST">
                    <input type="hidden" name="form-name" value="procurement" />
                    <input type="hidden" name="job" class="task-name-field" value="" />
                    <p class="hidden"><input name="bot-field" /></p>
                    <div class="space-y-3">
                      <input name="name" required placeholder="Your name" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#D4A017]" />
                      <input name="contact" required placeholder="Phone or email" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#D4A017]" />
                      <textarea name="message" rows="2" placeholder="Anything to add? (optional)" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#D4A017] resize-none"></textarea>
                      <label class="flex items-center gap-2 text-sm text-[#7A6652] cursor-pointer">
                        <input type="checkbox" name="anonymous" value="yes" class="rounded border-[#E8DDD0]" />
                        Keep my name private
                        <span class="relative inline-flex items-center ml-1">
                          <span class="anon-info-btn w-4 h-4 rounded-full bg-[#E8DDD0] text-[#7A6652] text-[9px] font-bold flex items-center justify-center leading-none cursor-pointer select-none">?</span>
                          <span class="anon-tooltip hidden absolute left-0 bottom-6 z-50 w-56 bg-[#2C2C2C] text-white rounded-xl px-3 py-2.5 shadow-xl text-left">
                            <p class="text-[11px] text-[#ccc] leading-relaxed">We like to barter with our neighbors - displaying your name lets others know who is helping in the community. We respect your privacy if you prefer not to.</p>
                          </span>
                        </span>
                      </label>
                      <div class="flex gap-3">
                        <button type="submit" class="submit-btn text-sm font-semibold bg-[#D4A017] text-[#2C2C2C] rounded-full px-5 py-2 hover:opacity-90 transition">Send</button>
                        <button type="button" class="task-cancel-btn text-sm text-[#7A6652] px-3 py-2 hover:text-[#2C2C2C] transition">Cancel</button>
                      </div>
                    </div>
                  </form>
                  <p class="success-msg hidden text-sm text-[#3B5E3A] font-medium py-2">Got it - I will reach out soon.</p>
                </div>
              )}
            </div>
          </li>

          <!-- Trade section -->
          <li class="trade-card-sheen bg-white rounded-xl shadow-sm border-l-4 border-[#16a34a] relative overflow-hidden">
            <button id="trade-toggle" class="have-toggle w-full px-5 py-4 flex items-center justify-between gap-4 text-left">
              <div>
                <p class="font-semibold">Trade your Eggs</p>
                <p class="text-sm text-[#16a34a] mt-1">Trade on the Market</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs font-semibold text-[#16a34a] bg-[#16a34a]/10 rounded-full px-3 py-1">Trade Eggs</span>
                <svg class="have-chevron w-4 h-4 text-[#16a34a] transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </button>
            <div class="have-body border-t border-[#16a34a]/20 px-5 py-4 space-y-3">
              <p class="text-sm font-semibold text-[#2C2C2C]">What do I do with all these eggs?</p>
              <p class="text-xs text-[#2C2C2C] -mt-1">Trade them here, or swap and gift them between friends for favors</p>
              <p class="text-xs text-[#16a34a] uppercase tracking-widest font-semibold pt-1">Exchange eggs for</p>
              <div class="grid grid-cols-2 gap-3">
                <div class="flex items-center justify-between gap-3 bg-[#f0fdf4] rounded-xl px-4 py-3 border border-[#16a34a]/20">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl">🍯</span>
                    <div>
                      <p class="font-semibold text-sm">Honey</p>
                      <p class="text-xs text-[#16a34a]/70">Rate set by market</p>
                    </div>
                  </div>
                  <span class="text-xs font-bold text-[#16a34a] shrink-0">25 $EGG</span>
                </div>
                <div class="flex items-center gap-3 bg-[#f0fdf4] rounded-xl px-4 py-3 border border-[#16a34a]/20">
                  <span class="text-2xl">🍺</span>
                  <div>
                    <p class="font-semibold text-sm">Beer</p>
                    <p class="text-xs text-[#16a34a]/70">Rate set by market</p>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 pt-1">
                <p class="text-xs text-[#7A6652]">Live rates on</p>
                <a href="https://homesteaders.netlify.app" target="_blank" rel="noopener" class="text-[10px] font-semibold text-[#16a34a] border-2 border-[#16a34a]/60 bg-[#16a34a]/8 rounded-full px-2.5 py-0.5 hover:bg-[#16a34a] hover:text-white transition">Homestead Exchange</a>
              </div>
            </div>
          </li>

          <!-- Job 3 - open skill trade -->
          <li class="job-card bg-white rounded-xl shadow-sm border-l-4 border-[#7A6652]">
            <div class="px-5 py-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold">Have a skill to offer?</p>
                  <p class="text-sm text-[#7A6652] mt-1">Carpentry, mechanical, electrical, or something else useful. Reach out and we will figure out a trade.</p>
                </div>
                <span class="text-xs font-semibold text-[#7A6652] bg-[#7A6652]/10 px-3 py-1 rounded-full whitespace-nowrap">Open trade</span>
              </div>
              <button class="claim-btn mt-4 text-sm font-semibold text-[#7A6652] border border-[#7A6652] rounded-full px-4 py-1.5 hover:bg-[#7A6652] hover:text-white transition">
                Propose a trade
              </button>
            </div>
            <div class="claim-form border-t border-[#F0E8DF] bg-[#FAF7F2] px-5 py-4">
              <form name="skill-offer" netlify netlify-honeypot="bot-field" method="POST">
                <input type="hidden" name="form-name" value="skill-offer" />
                <p class="hidden"><input name="bot-field" /></p>
                <div class="space-y-3">
                  <input name="name" required placeholder="Your name" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#7A6652]" />
                  <input name="contact" required placeholder="Phone or email" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#7A6652]" />
                  <textarea name="message" required rows="2" placeholder="What can you offer?" class="w-full text-sm border border-[#E8DDD0] rounded-lg px-4 py-2.5 bg-white focus:outline-none focus:border-2 focus:border-[#7A6652] resize-none"></textarea>
                  <div class="flex gap-3">
                    <button type="submit" class="submit-btn text-sm font-semibold bg-[#7A6652] text-white rounded-full px-5 py-2 hover:opacity-90 transition">Send</button>
                    <button type="button" class="cancel-btn text-sm text-[#7A6652] px-3 py-2 hover:text-[#2C2C2C] transition">Cancel</button>
                  </div>
                </div>
              </form>
              <p class="success-msg hidden text-sm text-[#3B5E3A] font-medium py-2">Got it - I will reach out soon.</p>
            </div>
          </li>

        </ul>
      </section>

    </main>

    <!-- Footer -->
    <footer class="px-6 py-10 max-w-3xl mx-auto text-center text-xs text-[#7A6652]">
      Homestead - local exchange, real goods, real people.
    </footer>

    <script>
      // --- Link preview cards ---
      const previewCache = new Map();

      function buildPreviewCard(url, data) {
        const domain = data.domain ?? new URL(url).hostname;
        const favicon = `https://www.google.com/s2/favicons?domain=${domain}&sz=16`;
        const escaped = (s) => s?.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;') ?? '';

        return `
          <a href="${escaped(url)}" target="_blank" rel="noopener noreferrer"
             class="block border border-[#E8DDD0] rounded-xl overflow-hidden hover:border-[#D4A017] transition bg-white no-underline">
            ${data.image ? `<img src="${escaped(data.image)}" alt="" class="w-full object-cover max-h-48" onerror="this.remove()" />` : ''}
            <div class="px-3 py-2.5 space-y-1">
              <div class="flex items-center gap-1.5">
                <img src="${favicon}" class="w-4 h-4 shrink-0" alt="" onerror="this.remove()" />
                <span class="text-[10px] text-[#7A6652] font-medium truncate">${escaped(domain)}</span>
              </div>
              ${data.title ? `<p class="text-xs font-semibold text-[#2C2C2C] line-clamp-2 leading-snug">${escaped(data.title)}</p>` : ''}
              ${data.description ? `<p class="text-[11px] text-[#7A6652] line-clamp-2 leading-snug">${escaped(data.description)}</p>` : ''}
            </div>
          </a>`;
      }

      async function loadPreviews(container) {
        const slots = container.querySelectorAll('.link-preview-slot[data-url]');
        slots.forEach(async (slot) => {
          const url = (slot as HTMLElement).dataset.url;
          if (!url || slot.dataset.loaded) return;
          slot.dataset.loaded = 'true';

          let data;
          if (previewCache.has(url)) {
            data = previewCache.get(url);
          } else {
            try {
              const res = await fetch(`/.netlify/functions/preview?url=${encodeURIComponent(url)}`);
              data = await res.json();
              previewCache.set(url, data);
            } catch {
              data = { title: null, description: null, image: null, domain: new URL(url).hostname };
              previewCache.set(url, data);
            }
          }
          slot.innerHTML = buildPreviewCard(url, data);
        });
      }

      // --- $EGG tooltips ---
      function wireTooltip(triggerSel, tooltipClass) {
        document.querySelectorAll(triggerSel).forEach(trigger => {
          const tooltip = trigger.closest('.relative')?.querySelector(`.${tooltipClass}`);
          trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = !tooltip?.classList.contains('hidden');
            document.querySelectorAll('.egg-tooltip, .egg-warn-tooltip').forEach(t => t.classList.add('hidden'));
            if (!isOpen) tooltip?.classList.remove('hidden');
          });
        });
      }
      wireTooltip('.egg-info-btn', 'egg-tooltip');
      wireTooltip('.egg-warn-trigger', 'egg-warn-tooltip');
      wireTooltip('.anon-info-btn', 'anon-tooltip');
      document.addEventListener('click', () => {
        document.querySelectorAll('.egg-tooltip, .egg-warn-tooltip, .anon-tooltip').forEach(t => t.classList.add('hidden'));
      });

      // Desktop hover
      if (window.matchMedia('(hover: hover)').matches) {
        [
          { trigger: '.egg-warn-trigger', tooltipClass: 'egg-warn-tooltip' },
          { trigger: '.egg-info-btn',     tooltipClass: 'egg-tooltip' },
          { trigger: '.anon-info-btn',    tooltipClass: 'anon-tooltip' },
        ].forEach(({ trigger, tooltipClass }) => {
          document.querySelectorAll(trigger).forEach(el => {
            const wrapper = el.closest('.relative');
            const tooltip = wrapper?.querySelector(`.${tooltipClass}`);
            let hideTimer;
            wrapper?.addEventListener('mouseenter', () => {
              clearTimeout(hideTimer);
              document.querySelectorAll('.egg-tooltip, .egg-warn-tooltip').forEach(t => t.classList.add('hidden'));
              tooltip?.classList.remove('hidden');
            });
            wrapper?.addEventListener('mouseleave', () => {
              hideTimer = setTimeout(() => tooltip?.classList.add('hidden'), 120);
            });
            tooltip?.addEventListener('mouseenter', () => clearTimeout(hideTimer));
            tooltip?.addEventListener('mouseleave', () => tooltip?.classList.add('hidden'));
          });
        });
      }

      // --- Mobile nav toggle ---
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      let navOpen = false;

      function closeNav() {
        navOpen = false;
        menu?.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
        bar1?.classList.remove('rotate-45', 'translate-y-2');
        bar2?.classList.remove('opacity-0');
        bar3?.classList.remove('-rotate-45', '-translate-y-2');
      }

      toggle?.addEventListener('click', () => {
        navOpen = !navOpen;
        menu?.classList.toggle('hidden', !navOpen);
        toggle.setAttribute('aria-expanded', String(navOpen));
        if (navOpen) {
          bar1?.classList.add('rotate-45', 'translate-y-2');
          bar2?.classList.add('opacity-0');
          bar3?.classList.add('-rotate-45', '-translate-y-2');
        } else {
          closeNav();
        }
      });

      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', closeNav);
      });

      // --- Simple job claim forms (open skill trade) ---
      document.querySelectorAll('.job-card').forEach(card => {
        const claimBtn = card.querySelector('.claim-btn');
        const formPanel = card.querySelector('.claim-form');
        const cancelBtn = card.querySelector('.cancel-btn');
        const form = card.querySelector('form');
        const successMsg = card.querySelector('.success-msg');

        claimBtn?.addEventListener('click', () => {
          formPanel?.classList.add('open');
          claimBtn.classList.add('hidden');
          formPanel?.querySelector('input[name="name"]')?.focus();
        });

        cancelBtn?.addEventListener('click', () => {
          formPanel?.classList.remove('open');
          claimBtn?.classList.remove('hidden');
          form?.reset();
        });

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = form.querySelector('.submit-btn');
          if (submitBtn) submitBtn.textContent = 'Sending...';
          try {
            await fetch('/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams(new FormData(form)).toString(),
            });
            form.classList.add('hidden');
            successMsg?.classList.remove('hidden');
          } catch {
            if (submitBtn) submitBtn.textContent = 'Send';
            alert('Something went wrong - please try again or email directly.');
          }
        });
      });

      // --- Accordion task cards ---
      document.querySelectorAll('.have-toggle').forEach(btn => {
        const body = btn.nextElementSibling;
        const chevron = btn.querySelector('.have-chevron');
        btn.addEventListener('click', () => {
          const isOpen = body?.classList.contains('open');
          body?.classList.toggle('open');
          chevron?.classList.toggle('rotate-180', !isOpen);

          if (!isOpen && btn.id === 'trade-toggle') {
            const rect = btn.getBoundingClientRect();
            const x = (rect.left + rect.width / 2) / window.innerWidth;
            const y = (rect.top + rect.height / 2) / window.innerHeight;
            confetti({
              particleCount: 60,
              spread: 70,
              origin: { x, y },
              colors: ['#D4A017', '#FFD700', '#16a34a', '#4ade80', '#ffffff'],
              shapes: ['star', 'circle'],
              scalar: 0.9,
              startVelocity: 28,
              gravity: 0.8,
              ticks: 180,
            });
          }
        });
      });

      document.querySelectorAll('.task-toggle').forEach(toggleBtn => {
        const card = toggleBtn.closest('li');
        const taskList = card?.querySelector('.task-list');
        const chevron = toggleBtn.querySelector('.task-chevron');

        toggleBtn.addEventListener('click', () => {
          const isOpen = taskList?.classList.contains('open');
          taskList?.classList.toggle('open');
          chevron?.classList.toggle('rotate-180', !isOpen);
          if (!isOpen && taskList) loadPreviews(taskList);
        });
      });

      document.querySelectorAll('.task-claim-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('li');
          const panel = card?.querySelector('.task-claim-panel');
          const label = card?.querySelector('.task-claim-label');
          const nameField = card?.querySelector('.task-name-field');
          const form = card?.querySelector('form');
          const successMsg = card?.querySelector('.success-msg');

          const task = btn.dataset.task ?? '';
          const eggs = btn.dataset.eggs ?? '';

          if (label) label.textContent = `Claiming: ${task} (${eggs} eggs)`;

          panel?.classList.add('open');
          successMsg?.classList.add('hidden');
          form?.classList.remove('hidden');

          // Clear visible fields only - never reset() which wipes hidden fields
          form?.querySelectorAll('input[type="text"], textarea').forEach(el => {
            (el as HTMLInputElement).value = '';
          });
          form?.querySelectorAll('input[type="checkbox"]').forEach(el => {
            (el as HTMLInputElement).checked = false;
          });

          if (nameField) (nameField as HTMLInputElement).value = `${task} (${eggs} eggs)`;
          panel?.querySelector('input[name="name"]')?.focus();
        });
      });

      document.querySelectorAll('.task-cancel-btn').forEach(btn => {
        const card = btn.closest('li');
        const panel = card?.querySelector('.task-claim-panel');
        const form = card?.querySelector('form');

        btn.addEventListener('click', () => {
          panel?.classList.remove('open');
          form?.reset();
        });
      });

      // Task pill modal
      const taskModal = document.getElementById('task-modal');

      function openTaskModal(pill: HTMLElement) {
        const task = pill.dataset.task ?? '';
        const eggs = pill.dataset.eggs ?? '';
        const status = pill.dataset.status ?? '';
        const image = pill.dataset.image ?? '';
        const url = pill.dataset.url ?? '';
        const formname = pill.dataset.formname ?? '';

        (document.getElementById('modal-task-name') as HTMLElement).textContent = task;
        (document.getElementById('modal-job-field') as HTMLInputElement).value = `${task} (${eggs} eggs)`;
        (document.getElementById('modal-form-name-field') as HTMLInputElement).value = formname;

        const eggsEl = document.getElementById('modal-eggs') as HTMLElement;
        eggsEl.textContent = `${eggs} eggs`;
        eggsEl.className = formname === 'procurement'
          ? 'text-xs font-semibold text-[#D4A017] bg-[#D4A017]/15 px-2.5 py-1 rounded-full'
          : 'text-xs font-semibold text-[#3B5E3A] bg-[#3B5E3A]/10 px-2.5 py-1 rounded-full';

        const eggWarn = document.getElementById('modal-egg-warn');
        if (parseInt(eggs) > 24) {
          eggWarn?.classList.remove('hidden');
        } else {
          eggWarn?.classList.add('hidden');
        }

        const imageWrap = document.getElementById('modal-image-wrap');
        if (image) {
          (document.getElementById('modal-image') as HTMLImageElement).src = image;
          imageWrap?.classList.remove('hidden');
        } else {
          imageWrap?.classList.add('hidden');
        }

        const linkWrap = document.getElementById('modal-link-wrap');
        if (url) {
          linkWrap?.classList.remove('hidden');
          document.getElementById('modal-link-loading')?.classList.remove('hidden');
          document.getElementById('modal-link-card')?.classList.add('hidden');
          (document.getElementById('modal-link-img') as HTMLImageElement).src = '';
          (document.getElementById('modal-link-title') as HTMLElement).textContent = '';
          (document.getElementById('modal-link-desc') as HTMLElement).textContent = '';
          (document.getElementById('modal-link-domain') as HTMLElement).textContent = '';
          fetch(`/.netlify/functions/preview?url=${encodeURIComponent(url)}`)
            .then(r => r.json())
            .then(data => {
              document.getElementById('modal-link-loading')?.classList.add('hidden');
              const card = document.getElementById('modal-link-card') as HTMLAnchorElement | null;
              if (!card) return;
              card.href = url;
              const imgEl = document.getElementById('modal-link-img') as HTMLImageElement;
              const banner = document.getElementById('modal-link-banner');
              if (data.image) {
                imgEl.src = data.image;
                imgEl.classList.remove('hidden');
                banner?.classList.add('hidden');
              } else {
                imgEl.classList.add('hidden');
                banner?.classList.remove('hidden');
              }
              (document.getElementById('modal-link-title') as HTMLElement).textContent = data.title || '';
              (document.getElementById('modal-link-desc') as HTMLElement).textContent = data.description || '';
              (document.getElementById('modal-link-domain') as HTMLElement).textContent = data.domain || new URL(url).hostname;
              card.classList.remove('hidden');
            })
            .catch(() => {
              document.getElementById('modal-link-loading')?.classList.add('hidden');
              const card = document.getElementById('modal-link-card') as HTMLAnchorElement | null;
              if (!card) return;
              card.href = url;
              (document.getElementById('modal-link-img') as HTMLImageElement).classList.add('hidden');
              document.getElementById('modal-link-banner')?.classList.remove('hidden');
              (document.getElementById('modal-link-domain') as HTMLElement).textContent = new URL(url).hostname;
              card.classList.remove('hidden');
            });
        } else {
          linkWrap?.classList.add('hidden');
        }

        const formWrap = document.getElementById('modal-form-wrap');
        const claimForm = document.getElementById('modal-claim-form') as HTMLFormElement | null;
        const modalSuccess = document.getElementById('modal-success');
        if (status === 'open') {
          formWrap?.classList.remove('hidden');
          claimForm?.classList.remove('hidden');
          modalSuccess?.classList.add('hidden');
          claimForm?.querySelectorAll('input[type="text"], textarea').forEach(el => (el as HTMLInputElement).value = '');
          claimForm?.querySelectorAll('input[type="checkbox"]').forEach(el => (el as HTMLInputElement).checked = false);
          const submitBtn = claimForm?.querySelector('.modal-submit-btn');
          if (submitBtn) submitBtn.textContent = 'Send';
        } else {
          formWrap?.classList.add('hidden');
        }

        taskModal?.classList.remove('hidden');
        taskModal?.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeTaskModal() {
        taskModal?.classList.add('hidden');
        taskModal?.classList.remove('flex');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.task-pill').forEach(pill => {
        pill.addEventListener('click', () => openTaskModal(pill as HTMLElement));
      });
      document.getElementById('modal-close')?.addEventListener('click', closeTaskModal);
      document.getElementById('modal-cancel')?.addEventListener('click', closeTaskModal);
      taskModal?.addEventListener('click', (e) => { if (e.target === taskModal) closeTaskModal(); });

      document.getElementById('modal-claim-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        const submitBtn = form.querySelector('.modal-submit-btn');
        if (submitBtn) submitBtn.textContent = 'Sending...';
        try {
          const formData = new FormData(form);
          const anonBox = form.querySelector('input[name="anonymous"]') as HTMLInputElement | null;
          formData.delete('anonymous');
          formData.append('anonymous', anonBox?.checked ? 'Yes' : 'No');
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString(),
          });
          form.classList.add('hidden');
          document.getElementById('modal-success')?.classList.remove('hidden');
        } catch {
          if (submitBtn) submitBtn.textContent = 'Send';
          alert('Something went wrong - please try again or email directly.');
        }
      });
    </script>

  <!-- Task detail modal -->
  <div id="task-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden">
      <div class="flex items-start justify-between px-5 pt-5 pb-3 gap-3">
        <div class="min-w-0">
          <p id="modal-task-name" class="font-semibold text-[#2C2C2C] leading-snug"></p>
          <div class="flex items-center gap-2 mt-2">
            <span id="modal-eggs" class="text-xs font-semibold px-2.5 py-1 rounded-full"></span>
            <span id="modal-egg-warn" class="relative hidden">
              <span class="egg-warn-trigger w-4 h-4 rounded-full bg-[#D4A017] text-[#1a1a1a] text-[9px] font-bold flex items-center justify-center leading-none cursor-pointer">!</span>
              <span class="egg-warn-tooltip hidden absolute left-0 top-6 z-50 w-72 bg-[#2C2C2C] text-white rounded-xl px-3.5 py-3 shadow-xl">
                <p class="text-xs font-semibold text-[#D4A017] mb-1.5">That's a lot of eggs.</p>
