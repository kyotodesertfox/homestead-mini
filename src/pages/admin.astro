---
const githubClientId = import.meta.env.GITHUB_CLIENT_ID ?? '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - Homestead</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: system-ui, sans-serif;
        background: #141414;
        color: #e5e5e5;
        min-height: 100vh;
      }

      #loading { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
      #login-screen { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1.5rem; }
      #admin-screen { max-width: 700px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

      .hidden { display: none !important; }

      /* Loading spinner */
      .spinner {
        width: 32px; height: 32px;
        border: 3px solid #333;
        border-top-color: #D4A017;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* Login */
      .login-wrap { width: 100%; max-width: 380px; }
      .login-brand { margin-bottom: 2rem; }
      .login-brand h1 { font-size: 1.5rem; font-weight: 700; color: #D4A017; }
      .login-brand p { font-size: 0.8rem; color: #666; margin-top: 0.25rem; }
      .login-box {
        background: #1e1e1e;
        border: 1px solid #2a2a2a;
        border-radius: 16px;
        padding: 1.75rem;
      }
      .login-box p { font-size: 0.85rem; color: #888; margin-bottom: 1.5rem; line-height: 1.6; }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.5rem 1.2rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: opacity 0.15s;
        text-decoration: none;
      }
      .btn:hover { opacity: 0.82; }
      .btn-green { background: #3B5E3A; color: #fff; }
      .btn-outline { background: transparent; border: 1px solid #3a3a3a; color: #888; }
      .btn-outline:hover { border-color: #555; color: #ccc; opacity: 1; }
      .btn-danger { background: transparent; border: 1px solid #5a2020; color: #c97070; font-size: 0.75rem; padding: 0.3rem 0.75rem; border-radius: 6px; }
      .btn-danger:hover { border-color: #7f3131; color: #e57373; opacity: 1; }
      .btn-github {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: #f0f6fc;
        color: #1a1a1a;
        border: none;
        padding: 0.6rem 1.4rem;
        font-size: 0.9rem;
      }
      .btn-publish {
        background: #3B5E3A;
        color: #fff;
        border: none;
      }
      .btn-publish:disabled { opacity: 0.45; cursor: default; }

      /* Admin header */
      .admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #242424;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .admin-header h1 { font-size: 1.1rem; font-weight: 700; color: #D4A017; }
      .admin-header .subtitle { font-size: 0.75rem; color: #555; margin-top: 0.2rem; }
      .header-right { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }

      /* Status message */
      #status-msg {
        font-size: 0.78rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        display: none;
      }
      #status-msg.ok { background: #1a2e1a; color: #6fcf6f; display: inline-block; }
      #status-msg.err { background: #2e1a1a; color: #e57373; display: inline-block; }

      /* Staging banner */
      #staging-banner {
        background: #192a19;
        border-bottom: 1px solid #2a452a;
        padding: 0.7rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .staging-text {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.8rem;
        color: #7ab87a;
      }
      .staging-dot {
        width: 7px; height: 7px;
        background: #6fcf6f;
        border-radius: 50%;
        flex-shrink: 0;
        animation: stagepulse 1.8s ease-in-out infinite;
      }
      @keyframes stagepulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

      /* Staged dot on tab label */
      .tab-staged-dot {
        display: inline-block;
        width: 6px; height: 6px;
        background: #D4A017;
        border-radius: 50%;
        margin-left: 5px;
        vertical-align: middle;
        position: relative;
        top: -1px;
      }

      /* Tabs */
      .tab-bar {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }
      .tab-btn {
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #2e2e2e;
        background: transparent;
        color: #888;
        transition: all 0.15s;
        letter-spacing: 0.01em;
      }
      .tab-btn.active {
        background: #D4A017;
        border-color: #D4A017;
        color: #1a1a1a;
      }
      .tab-btn:not(.active):hover {
        border-color: #444;
        color: #ccc;
      }

      /* Cards */
      #task-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }

      .task-card {
        background: #242424;
        border: 1px solid #363636;
        border-radius: 14px;
        overflow: hidden;
      }

      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.1rem;
        background: #1e1e1e;
        border-bottom: 1px solid #303030;
      }
      .task-num {
        font-size: 0.72rem;
        font-weight: 700;
        color: #D4A017;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .card-body {
        padding: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      .card-divider {
        height: 1px;
        background: #303030;
        margin: 0.1rem 0;
      }

      .field-group { display: flex; flex-direction: column; gap: 0.35rem; }
      .field-group label {
        font-size: 0.7rem;
        color: #888;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }

      input[type="text"],
      input[type="number"],
      select,
      textarea {
        background: #1a1a1a;
        border: 1px solid #363636;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        color: #e0e0e0;
        font-size: 0.875rem;
        width: 100%;
        font-family: inherit;
        transition: border-color 0.15s;
      }
      input:focus, select:focus, textarea:focus { outline: none; border-color: #D4A017; background: #1e1e1e; }
      select { cursor: pointer; }
      input::placeholder { color: #484848; }

      .check-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: #777;
        cursor: pointer;
        padding: 0.1rem 0;
      }
      .check-label:hover { color: #bbb; }
      input[type="checkbox"] { accent-color: #D4A017; width: 14px; height: 14px; cursor: pointer; flex-shrink: 0; }

      /* Empty state */
      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #444;
        font-size: 0.85rem;
        border: 1px dashed #2a2a2a;
        border-radius: 14px;
      }

      .add-task-row {
        text-align: center;
        padding: 0.75rem 0;
        margin-top: 0.25rem;
      }

      /* Publish modal */
      #publish-modal {
        position: fixed; inset: 0; z-index: 100;
        background: rgba(0,0,0,0.72);
        display: flex; align-items: center; justify-content: center; padding: 1.5rem;
      }
      .modal-box {
        background: #1e1e1e;
        border: 1px solid #363636;
        border-radius: 16px;
        padding: 2rem;
        max-width: 360px; width: 100%;
      }
      .modal-box h2 { font-size: 1.1rem; font-weight: 700; color: #e5e5e5; margin-bottom: 0.5rem; }
      .modal-box p { font-size: 0.85rem; color: #888; line-height: 1.6; margin-bottom: 1.75rem; }
      .modal-btns { display: flex; gap: 0.75rem; }
      .modal-btns .btn { flex: 1; text-align: center; }
    </style>
  </head>
  <body data-client-id={githubClientId}>

    <!-- Loading -->
    <div id="loading" class="hidden">
      <div class="spinner"></div>
    </div>

    <!-- Login -->
    <div id="login-screen">
      <div class="login-wrap">
        <div class="login-brand">
          <h1>Homestead</h1>
          <p>Admin portal</p>
        </div>
        <div class="login-box">
          <p>Sign in with GitHub to manage tasks. You will be redirected back here after authorizing.</p>
        <a id="github-login-btn" class="btn btn-github" href="#">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          Sign in with GitHub
        </a>
        </div>
      </div>
    </div>

    <!-- Staging banner (outside admin-screen, shown when in draft mode) -->
    <div id="staging-banner" class="hidden">
      <div class="staging-text">
        <span class="staging-dot"></span>
        <span id="staging-label">Draft mode active - save changes to stage them.</span>
      </div>
      <button class="btn btn-publish" id="publish-btn">Publish to site</button>
    </div>

    <!-- Admin -->
    <div id="admin-screen" class="hidden">
      <div class="admin-header">
        <div>
          <h1>Homestead Admin</h1>
          <p class="subtitle" id="admin-subtitle">Ready</p>
        </div>
        <div class="header-right">
          <span id="status-msg"></span>
          <button class="btn btn-green" id="save-btn">Save draft</button>
          <button class="btn btn-outline" id="logout-btn">Sign out</button>
        </div>
      </div>

      <div class="tab-bar">
        <button class="tab-btn active" data-tab="tasks">Homestead Tasks</button>
        <button class="tab-btn" data-tab="procurement">Procurement</button>
      </div>

      <div id="task-list"></div>

      <div class="add-task-row">
        <button class="btn btn-outline" id="add-task-btn">+ Add item</button>
      </div>
    </div>

    <!-- Publish confirm modal -->
    <div id="publish-modal" class="hidden">
      <div class="modal-box">
        <h2>Publish to site?</h2>
        <p>All staged changes will go live in about 30 seconds.</p>
        <div class="modal-btns">
          <button class="btn btn-outline" id="modal-cancel">Cancel</button>
          <button class="btn btn-publish" id="modal-confirm">Publish now</button>
        </div>
      </div>
    </div>

    <script>
      const REPO = 'kyotodesertfox/homestead-mini';
      const FILES = {
        tasks: 'src/data/tasks.json',
        procurement: 'src/data/procurement.json',
      };
      const API = 'https://api.github.com';
      const CLIENT_ID = (document.body as HTMLBodyElement).dataset.clientId ?? '';

      let token = localStorage.getItem('github_token');
      let activeTab = 'tasks';
      let currentBranch: string | null = null;
      const stagedTabs = new Set<string>();

      const state: Record<string, { sha: string | null; items: any[]; loaded: boolean }> = {
        tasks:       { sha: null, items: [], loaded: false },
        procurement: { sha: null, items: [], loaded: false },
      };

      // --- Screens ---
      function show(id: string) {
        ['loading', 'login-screen', 'admin-screen'].forEach(s => {
          document.getElementById(s)?.classList.toggle('hidden', s !== id);
        });
      }

      function setStatus(msg: string, isErr = false) {
        const el = document.getElementById('status-msg')!;
        el.textContent = msg;
        el.className = isErr ? 'err' : 'ok';
        if (!isErr) setTimeout(() => { el.className = ''; el.textContent = ''; }, 4000);
      }

      // --- GitHub login ---
      const loginBtn = document.getElementById('github-login-btn');
      if (loginBtn && CLIENT_ID) {
        loginBtn.setAttribute('href', `https://github.com/login/oauth/authorize?client_id=${CLIENT_ID}&scope=repo&allow_signup=false`);
      }

      // --- OAuth callback ---
      async function exchangeCode(code: string) {
        show('loading');
        try {
          const res = await fetch(`/.netlify/functions/auth?code=${encodeURIComponent(code)}`);
          const data = await res.json();
          if (data.token) {
            token = data.token;
            localStorage.setItem('github_token', token!);
            await init();
          } else {
            show('login-screen');
            const errMsg = data.error_description || data.error || 'Auth failed - try again.';
            const hasIds = `(client_id: ${data.debug_has_client_id}, secret: ${data.debug_has_client_secret})`;
            const box = document.querySelector('.login-box p');
            if (box) box.textContent = `${errMsg} ${hasIds}`;
          }
        } catch (e: any) {
          show('login-screen');
          const box = document.querySelector('.login-box p');
          if (box) box.textContent = `Auth error: ${e.message}`;
        }
      }

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        localStorage.removeItem('github_token');
        token = null;
        currentBranch = null;
        stagedTabs.clear();
        show('login-screen');
      });

      // --- GitHub API ---
      async function ghGet(path: string) {
        const res = await fetch(`${API}${path}`, {
          headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.v3+json' }
        });
        if (!res.ok) return null;
        return res.json();
      }

      async function ghPut(path: string, body: object) {
        return fetch(`${API}${path}`, {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${token}`,
            Accept: 'application/vnd.github.v3+json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        });
      }

      // --- Branch operations ---
      async function checkDraftBranch() {
        const res = await ghGet(`/repos/${REPO}/git/ref/heads/draft`);
        if (res) {
          currentBranch = 'draft';
          return true;
        }
        return false;
      }

      async function ensureDraftBranch() {
        if (currentBranch === 'draft') return true;
        const mainRef = await ghGet(`/repos/${REPO}/git/ref/heads/main`);
        if (!mainRef) return false;
        await fetch(`${API}/repos/${REPO}/git/refs`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ ref: 'refs/heads/draft', sha: mainRef.object.sha }),
        });
        // 422 = already exists, fine
        currentBranch = 'draft';
        return true;
      }

      function updateStagingBanner() {
        const banner = document.getElementById('staging-banner')!;
        const label = document.getElementById('staging-label')!;
        const subtitle = document.getElementById('admin-subtitle')!;

        if (currentBranch === 'draft') {
          banner.classList.remove('hidden');
          const count = stagedTabs.size;
          label.textContent = count > 0
            ? `${count} tab${count > 1 ? 's' : ''} staged - not live yet.`
            : 'Draft mode active - save changes to stage them.';
          subtitle.textContent = 'Draft mode';
        } else {
          banner.classList.add('hidden');
          subtitle.textContent = 'Ready';
        }

        // Tab staged dots
        document.querySelectorAll('.tab-btn').forEach(btn => {
          const tab = (btn as HTMLElement).dataset.tab!;
          const existing = btn.querySelector('.tab-staged-dot');
          if (stagedTabs.has(tab)) {
            if (!existing) btn.insertAdjacentHTML('beforeend', '<span class="tab-staged-dot"></span>');
          } else {
            existing?.remove();
          }
        });
      }

      // --- Load tab ---
      async function loadTab(tab: string) {
        if (state[tab].loaded) { renderItems(); return; }
        show('loading');
        const branch = currentBranch || 'main';
        const data = await ghGet(`/repos/${REPO}/contents/${FILES[tab]}?ref=${branch}`);
        if (!data) {
          localStorage.removeItem('github_token');
          token = null;
          show('login-screen');
          return;
        }
        state[tab].sha = data.sha;
        state[tab].items = JSON.parse(atob(data.content.replace(/\n/g, '')));
        state[tab].loaded = true;
        renderItems();
        show('admin-screen');
      }

      async function init() {
        await checkDraftBranch();
        await loadTab(activeTab);
        updateStagingBanner();
      }

      // --- Render ---
      function esc(s: any) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
      }

      function taskCard(t: any, i: number) {
        const opts = ['open','pending','claimed'].map(s =>
          `<option value="${s}" ${t.status === s ? 'selected' : ''}>${s}</option>`
        ).join('');
        return `
          <div class="task-card" data-index="${i}">
            <div class="card-header">
              <span class="task-num">Task ${i + 1}</span>
              <button class="btn btn-danger delete-btn" data-index="${i}">Remove</button>
            </div>
            <div class="card-body">
              <div class="field-group">
                <label>Description</label>
                <input type="text" name="task" value="${esc(t.task)}" placeholder="Describe the task" />
              </div>
              <div class="field-group">
                <label>Image URL</label>
                <input type="text" name="image" value="${esc(t.image ?? '')}" placeholder="/photo.jpg or https://..." />
              </div>
              <div class="card-divider"></div>
              <div class="field-row">
                <div class="field-group">
                  <label>Eggs</label>
                  <input type="number" name="eggs" value="${t.eggs ?? 0}" min="0" />
                </div>
                <div class="field-group">
                  <label>Status</label>
                  <select name="status">${opts}</select>
                </div>
              </div>
              <div class="field-group">
                <label>Claimed by</label>
                <input type="text" name="claimedBy" value="${esc(t.claimedBy ?? '')}" placeholder="Leave blank if open" />
              </div>
              <label class="check-label">
                <input type="checkbox" name="anonymous" ${t.anonymous ? 'checked' : ''} />
                Keep name private (show as Anonymous)
              </label>
              <input type="hidden" name="id" value="${esc(t.id)}" />
              <input type="hidden" name="category" value="${esc(t.category ?? 'garden')}" />
            </div>
          </div>`;
      }

      function procurementCard(t: any, i: number) {
        const opts = ['open','pending','claimed'].map(s =>
          `<option value="${s}" ${t.status === s ? 'selected' : ''}>${s}</option>`
        ).join('');
        return `
          <div class="task-card" data-index="${i}">
            <div class="card-header">
              <span class="task-num">Item ${i + 1}</span>
              <button class="btn btn-danger delete-btn" data-index="${i}">Remove</button>
            </div>
            <div class="card-body">
            <div class="field-group">
              <label>Description</label>
              <input type="text" name="task" value="${esc(t.task)}" placeholder="What are you looking to source?" />
            </div>
            <div class="field-group">
              <label>Reference URL</label>
              <input type="text" name="url" value="${esc(t.url ?? '')}" placeholder="https://..." />
            </div>
            <div class="card-divider"></div>
            <div class="field-row">
              <div class="field-group">
                <label>Eggs</label>
                <input type="number" name="eggs" value="${t.eggs ?? 0}" min="0" />
              </div>
              <div class="field-group">
                <label>Status</label>
                <select name="status">${opts}</select>
              </div>
            </div>
            <div class="field-group">
              <label>Claimed by</label>
              <input type="text" name="claimedBy" value="${esc(t.claimedBy ?? '')}" placeholder="Leave blank if open" />
            </div>
            <label class="check-label">
              <input type="checkbox" name="anonymous" ${t.anonymous ? 'checked' : ''} />
              Keep name private (show as Anonymous)
            </label>
            <input type="hidden" name="id" value="${esc(t.id)}" />
            </div>
          </div>`;
      }

      function renderItems() {
        const list = document.getElementById('task-list')!;
        const items = state[activeTab].items;
        const cardFn = activeTab === 'procurement' ? procurementCard : taskCard;
        if (items.length === 0) {
          const label = activeTab === 'procurement' ? 'procurement items' : 'tasks';
          list.innerHTML = `<div class="empty-state">No ${label} yet - add one below.</div>`;
          return;
        }
        list.innerHTML = items.map((t, i) => cardFn(t, i)).join('');
        list.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            state[activeTab].items.splice(parseInt((btn as HTMLElement).dataset.index!), 1);
            renderItems();
          });
        });

        if (activeTab === 'procurement') {
          list.querySelectorAll('input[name="url"]').forEach(input => {
            input.addEventListener('blur', async () => {
              const urlVal = (input as HTMLInputElement).value.trim();
              if (!urlVal) return;
              const card = input.closest('.task-card');
              const descField = card?.querySelector('input[name="task"]') as HTMLInputElement | null;
              if (!descField || descField.value.trim()) return;
              descField.placeholder = 'Fetching title...';
              try {
                const res = await fetch(`/.netlify/functions/preview?url=${encodeURIComponent(urlVal)}`);
                const data = await res.json();
                if (data.title && !descField.value.trim()) {
                  descField.value = data.title;
                }
              } catch { /* leave blank */ }
              descField.placeholder = 'What are you looking to source?';
            });
          });
        }
      }

      // --- Collect ---
      function collectItems() {
        return Array.from(document.querySelectorAll('.task-card')).map(card => {
          const g = (name: string) => (card.querySelector(`[name="${name}"]`) as HTMLInputElement);
          const claimedBy = g('claimedBy').value.trim();
          if (activeTab === 'procurement') {
            const url = g('url').value.trim();
            return {
              id: g('id').value || `item-${Date.now()}`,
              task: g('task').value.trim(),
              url: url || null,
              eggs: parseInt(g('eggs').value) || 0,
              status: g('status').value,
              claimedBy: claimedBy || null,
              anonymous: (g('anonymous') as HTMLInputElement).checked,
            };
          }
          const image = g('image').value.trim();
          return {
            id: g('id').value || `task-${Date.now()}`,
            category: g('category').value || 'garden',
            task: g('task').value.trim(),
            eggs: parseInt(g('eggs').value) || 0,
            status: g('status').value,
            claimedBy: claimedBy || null,
            anonymous: (g('anonymous') as HTMLInputElement).checked,
            image: image || null,
          };
        });
      }

      // --- Tabs ---
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const tab = (btn as HTMLElement).dataset.tab!;
          if (tab === activeTab) return;
          activeTab = tab;
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b === btn));
          await loadTab(tab);
        });
      });

      // --- Save draft ---
      document.getElementById('save-btn')?.addEventListener('click', async () => {
        const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
        saveBtn.textContent = 'Saving...';
        saveBtn.disabled = true;

        const ok = await ensureDraftBranch();
        if (!ok) {
          setStatus('Could not create draft branch.', true);
          saveBtn.textContent = 'Save draft';
          saveBtn.disabled = false;
          return;
        }

        const updated = collectItems();
        const newJson = JSON.stringify(updated, null, 2);
        const label = activeTab === 'procurement' ? 'procurement' : 'tasks';

        const res = await ghPut(`/repos/${REPO}/contents/${FILES[activeTab]}`, {
          message: `Draft: update ${label}`,
          content: btoa(unescape(encodeURIComponent(newJson))),
          sha: state[activeTab].sha,
          branch: 'draft',
        });

        if (res.ok) {
          const data = await res.json();
          state[activeTab].sha = data.content.sha;
          state[activeTab].items = updated;
          stagedTabs.add(activeTab);
          updateStagingBanner();
          setStatus('Draft saved.');
        } else {
          setStatus('Save failed - token may have expired.', true);
        }

        saveBtn.textContent = 'Save draft';
        saveBtn.disabled = false;
      });

      // --- Add item ---
      document.getElementById('add-task-btn')?.addEventListener('click', () => {
        const blank = activeTab === 'procurement'
          ? { id: `item-${Date.now()}`, task: '', url: null, eggs: 0, status: 'open', claimedBy: null, anonymous: false }
          : { id: `task-${Date.now()}`, category: 'garden', task: '', eggs: 0, status: 'open', claimedBy: null, anonymous: false, image: null };
        state[activeTab].items.push(blank);
        renderItems();
        document.querySelector('.task-card:last-child')?.scrollIntoView({ behavior: 'smooth' });
      });

      // --- Publish ---
      document.getElementById('publish-btn')?.addEventListener('click', () => {
        document.getElementById('publish-modal')!.classList.remove('hidden');
      });

      document.getElementById('modal-cancel')?.addEventListener('click', () => {
        document.getElementById('publish-modal')!.classList.add('hidden');
      });

      document.getElementById('modal-confirm')?.addEventListener('click', async () => {
        const btn = document.getElementById('modal-confirm') as HTMLButtonElement;
        btn.textContent = 'Publishing...';
        btn.disabled = true;

        const res = await fetch(`${API}/repos/${REPO}/merges`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            base: 'main',
            head: 'draft',
            commit_message: `Publish: ${new Date().toLocaleString()}`,
          }),
        });

        document.getElementById('publish-modal')!.classList.add('hidden');
        btn.textContent = 'Publish now';
        btn.disabled = false;

        if (res.ok || res.status === 204) {
          // Clean up draft branch
          await fetch(`${API}/repos/${REPO}/git/refs/heads/draft`, {
            method: 'DELETE',
            headers: { Authorization: `Bearer ${token}` },
          });
          currentBranch = null;
          stagedTabs.clear();
          Object.values(state).forEach(s => { s.loaded = false; s.sha = null; });
          updateStagingBanner();
          setStatus('Published. Site will update in ~30 seconds.');
          await loadTab(activeTab);
        } else {
          setStatus('Publish failed - check your connection.', true);
        }
      });

      // --- Entry point ---
      const params = new URLSearchParams(window.location.search);
      const oauthCode = params.get('code');

      if (oauthCode) {
        history.replaceState({}, '', '/admin');
        exchangeCode(oauthCode);
      } else if (token) {
        init();
      } else {
        show('login-screen');
      }
    </script>

  </body>
</html>
