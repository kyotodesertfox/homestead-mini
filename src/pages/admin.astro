---
// Admin panel - client side only, no server rendering needed
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - Homestead</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: system-ui, sans-serif;
        background: #1a1a1a;
        color: #e5e5e5;
        min-height: 100vh;
        padding: 2rem 1rem;
      }

      #loading, #login-screen, #admin-screen { max-width: 680px; margin: 0 auto; }

      .hidden { display: none !important; }

      h1 { font-size: 1.25rem; font-weight: 700; color: #D4A017; margin-bottom: 0.25rem; }
      .subtitle { font-size: 0.8rem; color: #888; margin-bottom: 2rem; }

      /* Login */
      .login-box {
        background: #242424;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 2rem;
      }
      .login-box p { font-size: 0.85rem; color: #aaa; margin-bottom: 1.25rem; line-height: 1.6; }
      .login-box input {
        width: 100%;
        background: #1a1a1a;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        color: #e5e5e5;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
        font-family: monospace;
      }
      .login-box input:focus { outline: none; border-color: #D4A017; }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.5rem 1.2rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: opacity 0.15s;
      }
      .btn:hover { opacity: 0.85; }
      .btn-gold { background: #D4A017; color: #1a1a1a; }
      .btn-green { background: #3B5E3A; color: #fff; }
      .btn-outline { background: transparent; border: 1px solid #555; color: #aaa; }
      .btn-danger { background: transparent; border: 1px solid #7f3131; color: #e57373; font-size: 0.75rem; padding: 0.3rem 0.75rem; }

      /* Toolbar */
      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .toolbar-right { display: flex; gap: 0.5rem; align-items: center; }

      /* Status message */
      #status-msg {
        font-size: 0.8rem;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        background: #2a2a2a;
        color: #aaa;
        display: none;
      }
      #status-msg.ok { background: #1e3a1e; color: #6fcf6f; display: inline-block; }
      #status-msg.err { background: #3a1e1e; color: #e57373; display: inline-block; }

      /* Task cards */
      #task-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }

      .task-card {
        background: #242424;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .task-num { font-size: 0.75rem; font-weight: 700; color: #D4A017; text-transform: uppercase; letter-spacing: 0.05em; }

      .field-group { display: flex; flex-direction: column; gap: 0.3rem; }
      .field-group label { font-size: 0.75rem; color: #888; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }

      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }

      input[type="text"],
      input[type="number"],
      select,
      textarea {
        background: #1a1a1a;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        color: #e5e5e5;
        font-size: 0.875rem;
        width: 100%;
        font-family: inherit;
      }
      input:focus, select:focus, textarea:focus { outline: none; border-color: #D4A017; }
      select { cursor: pointer; }

      .status-open { color: #6fcf6f; }
      .status-pending { color: #D4A017; }
      .status-claimed { color: #aaa; }

      .check-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #aaa;
        cursor: pointer;
      }
      input[type="checkbox"] { accent-color: #D4A017; width: 15px; height: 15px; cursor: pointer; }

      .add-task-row { text-align: center; padding: 0.5rem 0; }
    </style>
  </head>
  <body>

    <!-- Loading -->
    <div id="loading" class="hidden">
      <p style="color:#888;font-size:0.9rem;">Loading tasks...</p>
    </div>

    <!-- Login -->
    <div id="login-screen">
      <h1>Homestead Admin</h1>
      <p class="subtitle">Task management</p>
      <div class="login-box">
        <p>Enter a GitHub personal access token with <strong>Contents: Read &amp; Write</strong> access to <code>kyotodesertfox/homestead-mini</code>.</p>
        <input type="password" id="token-input" placeholder="github_pat_..." autocomplete="off" />
        <button class="btn btn-gold" id="login-btn">Sign in</button>
      </div>
    </div>

    <!-- Admin -->
    <div id="admin-screen" class="hidden">
      <div class="toolbar">
        <div>
          <h1>Homestead Admin</h1>
          <p class="subtitle">Edit tasks below - changes go live after Netlify redeploys (~30s)</p>
        </div>
        <div class="toolbar-right">
          <span id="status-msg"></span>
          <button class="btn btn-green" id="save-btn">Save to site</button>
          <button class="btn btn-outline" id="logout-btn">Sign out</button>
        </div>
      </div>

      <div id="task-list"></div>

      <div class="add-task-row">
        <button class="btn btn-outline" id="add-task-btn">+ Add task</button>
      </div>
    </div>

    <script>
      const REPO = 'kyotodesertfox/homestead-mini';
      const FILE_PATH = 'src/data/tasks.json';
      const API = 'https://api.github.com';

      let token = localStorage.getItem('github_token');
      let currentSha = null;
      let tasks = [];

      // --- Screens ---
      function show(id) {
        ['loading', 'login-screen', 'admin-screen'].forEach(s => {
          document.getElementById(s)?.classList.toggle('hidden', s !== id);
        });
      }

      function setStatus(msg, isErr = false) {
        const el = document.getElementById('status-msg');
        el.textContent = msg;
        el.className = isErr ? 'err' : 'ok';
        if (!isErr) setTimeout(() => { el.className = ''; el.textContent = ''; }, 4000);
      }

      // --- Auth ---
      document.getElementById('login-btn')?.addEventListener('click', async () => {
        const val = (document.getElementById('token-input') as HTMLInputElement).value.trim();
        if (!val) return;
        token = val;
        localStorage.setItem('github_token', token);
        await init();
      });

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        localStorage.removeItem('github_token');
        token = null;
        show('login-screen');
      });

      // --- GitHub API ---
      async function ghGet(path) {
        const res = await fetch(`${API}${path}`, {
          headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.v3+json' }
        });
        if (!res.ok) return null;
        return res.json();
      }

      async function ghPut(path, body) {
        const res = await fetch(`${API}${path}`, {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${token}`,
            Accept: 'application/vnd.github.v3+json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        });
        return res;
      }

      // --- Load ---
      async function init() {
        show('loading');
        const data = await ghGet(`/repos/${REPO}/contents/${FILE_PATH}`);
        if (!data) {
          localStorage.removeItem('github_token');
          token = null;
          show('login-screen');
          return;
        }
        currentSha = data.sha;
        tasks = JSON.parse(atob(data.content.replace(/\n/g, '')));
        renderTasks();
        show('admin-screen');
      }

      // --- Render ---
      function esc(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
      }

      function taskCard(t, i) {
        const statuses = ['open', 'pending', 'claimed'];
        const opts = statuses.map(s =>
          `<option value="${s}" ${t.status === s ? 'selected' : ''}>${s}</option>`
        ).join('');

        return `
          <div class="task-card" data-index="${i}">
            <div class="card-header">
              <span class="task-num">Task ${i + 1}</span>
              <button class="btn btn-danger delete-btn" data-index="${i}">Remove</button>
            </div>

            <div class="field-group">
              <label>Task description</label>
              <input type="text" name="task" value="${esc(t.task)}" placeholder="Describe the task" />
            </div>

            <div class="field-row">
              <div class="field-group">
                <label>Eggs</label>
                <input type="number" name="eggs" value="${t.eggs ?? 0}" min="0" />
              </div>
              <div class="field-group">
                <label>Status</label>
                <select name="status">${opts}</select>
              </div>
            </div>

            <div class="field-group">
              <label>Claimed by</label>
              <input type="text" name="claimedBy" value="${esc(t.claimedBy ?? '')}" placeholder="Leave blank if open" />
            </div>

            <label class="check-label">
              <input type="checkbox" name="anonymous" ${t.anonymous ? 'checked' : ''} />
              Keep name private (show as Anonymous)
            </label>

            <div class="field-group">
              <label>Image URL</label>
              <input type="text" name="image" value="${esc(t.image ?? '')}" placeholder="/photo.jpg or https://..." />
            </div>

            <input type="hidden" name="id" value="${esc(t.id)}" />
            <input type="hidden" name="category" value="${esc(t.category)}" />
          </div>
        `;
      }

      function renderTasks() {
        const list = document.getElementById('task-list');
        list.innerHTML = tasks.map((t, i) => taskCard(t, i)).join('');
        list.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            tasks.splice(parseInt((btn as HTMLElement).dataset.index), 1);
            renderTasks();
          });
        });
      }

      // --- Collect ---
      function collectTasks() {
        return Array.from(document.querySelectorAll('.task-card')).map(card => {
          const g = (name) => (card.querySelector(`[name="${name}"]`) as HTMLInputElement);
          const claimedBy = g('claimedBy').value.trim();
          const image = g('image').value.trim();
          return {
            id: g('id').value || `task-${Date.now()}`,
            category: g('category').value || 'garden',
            task: g('task').value.trim(),
            eggs: parseInt(g('eggs').value) || 0,
            status: g('status').value,
            claimedBy: claimedBy || null,
            anonymous: (g('anonymous') as HTMLInputElement).checked,
            image: image || null,
          };
        });
      }

      // --- Save ---
      document.getElementById('save-btn')?.addEventListener('click', async () => {
        const saveBtn = document.getElementById('save-btn');
        saveBtn.textContent = 'Saving...';
        (saveBtn as HTMLButtonElement).disabled = true;

        const updated = collectTasks();
        const newJson = JSON.stringify(updated, null, 2);

        const res = await ghPut(`/repos/${REPO}/contents/${FILE_PATH}`, {
          message: 'Update tasks via admin panel',
          content: btoa(unescape(encodeURIComponent(newJson))),
          sha: currentSha,
        });

        if (res.ok) {
          const data = await res.json();
          currentSha = data.content.sha;
          tasks = updated;
          setStatus('Saved. Site will update in ~30 seconds.');
        } else {
          setStatus('Save failed - check your token has write access.', true);
        }

        saveBtn.textContent = 'Save to site';
        (saveBtn as HTMLButtonElement).disabled = false;
      });

      // --- Add task ---
      document.getElementById('add-task-btn')?.addEventListener('click', () => {
        tasks.push({
          id: `task-${Date.now()}`,
          category: 'garden',
          task: '',
          eggs: 0,
          status: 'open',
          claimedBy: null,
          anonymous: false,
          image: null,
        });
        renderTasks();
        document.querySelector('.task-card:last-child')?.scrollIntoView({ behavior: 'smooth' });
      });

      // --- Init ---
      if (token) {
        init();
      } else {
        show('login-screen');
      }
    </script>

  </body>
</html>
